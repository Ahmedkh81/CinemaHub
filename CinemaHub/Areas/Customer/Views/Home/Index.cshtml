@using CinemaHub.Models
@model List<Movie>

@section Scripts {
    <script>
        setTimeout(() => {
            const toastElList = document.querySelectorAll('.custom-toast');
            toastElList.forEach(toast => {
                toast.classList.add('fade');
                setTimeout(() => toast.remove(), 500); // remove after fade-out
            });
        }, 4000);
    </script>
}

@if (TempData["success-notification"] != null)
{
    <div class="custom-toast alert alert-success alert-dismissible shadow-lg rounded-4 fade show"
         role="alert"
         style="position: fixed; top: 20px; right: 20px; z-index: 1060; min-width: 300px;">
        <strong>✅ Success!</strong> @TempData["success-notification"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["error-notification"] != null)
{
    <div class="custom-toast alert alert-danger alert-dismissible shadow-lg rounded-4 fade show"
         role="alert"
         style="position: fixed; top: 20px; right: 20px; z-index: 1060; min-width: 300px;">
        <strong>❌ Error!</strong> @TempData["error-notification"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<!-- Search -->
<form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
    <input type="text" name="search" class="form-control w-50 me-2 shadow-sm" placeholder="🔍 Search movies..." value="@ViewBag.Search" />
    <button type="submit" class="btn btn-outline-primary fw-bold">Search</button>
</form>

<!-- Movie Cards -->
<div class="container">
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            <div class="col-12">
                <div class="card flex-row border-0 rounded-4 shadow-sm overflow-hidden hover-zoom" style="min-height: 220px;">
                    <!-- Image -->
                    <img src="~/Images/@movie.ImageUrl" class="img-fluid" style="width: 250px; object-fit: cover;" alt="@movie.Name" />

                    <!-- Info -->
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold text-primary">@movie.Name</h5>
                            <p class="mb-1 text-muted"><strong>Price:</strong> <span class="text-success">@movie.Price.ToString("C")</span></p>
                            <p class="mb-1 text-muted"><strong>Cinema:</strong> @movie.Cinema.Name</p>
                            <p class="mb-1 text-muted"><strong>📅 Date:</strong> @movie.StartDate.ToShortDateString() - @movie.EndDate.ToShortDateString()</p>
                            <p class="mb-2 text-muted"><strong>🎬 Category:</strong> @movie.Category.Name</p>

                            <span class="badge rounded-pill @(movie.MovieStatus == MovieStatus.Available ? "bg-success" : movie.MovieStatus == MovieStatus.Upcoming ? "bg-warning text-dark" : "bg-danger")">
                                @movie.MovieStatus
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a href="/Customer/Details/Index/@movie.Id" class="text-decoration-none fw-semibold">🎥 More Details</a>

                            @if (movie.MovieStatus == MovieStatus.Expired)
                            {
                                <button type="button"
                                        class="btn btn-sm fw-bold px-3 btn-outline-secondary"
                                        disabled>
                                    🛒 Add to cart (Expired)
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm fw-bold px-3 btn-outline-success"
                                        data-bs-toggle="modal"
                                        data-bs-target="#addToCartModal-@movie.Id">
                                    🛒 Add to cart
                                </button>
                            }


                        </div>
                    </div>
                </div>
            </div>

            @* START MODAL *@
            <div class="modal fade" id="addToCartModal-@movie.Id" tabindex="-1" aria-labelledby="addToCartLabel-@movie.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-white">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addToCartLabel-@movie.Id">Choose Tickets and Showtime</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" method="post">
                            <div class="modal-body">
                                <input type="hidden" name="movieId" value="@movie.Id" />

                                <div class="mb-3">
                                    <label class="form-label">Show Time</label>
                                    <select name="scheduleId" class="form-select" required>
                                        <option value="">-- Select Show Time --</option>
                                        @foreach (var show in movie.MovieSchedules)
                                        {
                                            <option value="@show.Id">@show.ShowTime.ToString("dd MMM yyyy - hh:mm tt")</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Tickets</label>
                                    <input type="number" name="count" class="form-control" value="1" min="1" max="@movie.AvailableTickets" required />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Add to Cart</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            @* END MODAL *@
        }
    </div>
</div>



<!-- Pagination -->
@if (ViewBag.totalPages > 1)
{
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            @if (ViewBag.currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="/Customer/Home/index?page=@(ViewBag.currentPage - 1)&search=@ViewBag.search">Previous</a>
                </li>
            }
            @for (int i = 1; i <= ViewBag.totalPages; i++)
            {
                <li class="page-item @(i == ViewBag.currentPage ? "active" : "")">
                    <a class="page-link" href="/Customer/Home/index?page=@i&search=@ViewBag.search">@i</a>
                </li>
            }
            @if (ViewBag.currentPage < ViewBag.totalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="/Customer/Home/index?page=@(ViewBag.currentPage + 1)&search=@ViewBag.search">Next</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Styles -->
<style>
    .hover-zoom {
        transition: transform 0.3s ease-in-out;
    }

        .hover-zoom:hover {
            transform: scale(1.02);
        }

    .card-body p {
        margin-bottom: 0.4rem;
    }
</style>


