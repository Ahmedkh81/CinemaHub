@model Movie

<div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
    <div class="row g-0">
        <!-- الصورة -->
        <div class="col-md-5">
            <img src="~/Images/@Model.ImageUrl" alt="@Model.Name"
                 class="img-fluid h-100 object-fit-cover" style="object-fit: cover;" />
        </div>

        <!-- التفاصيل -->
        <div class="col-md-7 p-4 d-flex flex-column justify-content-between">
            <div>
                <h2 class="text-primary fw-bold mb-3">@Model.Name</h2>
                <p class="text-muted">@Model.Description</p>

                <div class="row mb-3">
                    <div class="col-sm-6 mb-2">
                        <strong>🎟️ Price:</strong> <span class="text-success">@Model.Price.ToString("C")</span>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>🏢 Cinema:</strong> @Model.Cinema.Name
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>📅 Start:</strong> @Model.StartDate.ToShortDateString()
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>📅 End:</strong> @Model.EndDate.ToShortDateString()
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>📂 Category:</strong> @Model.Category.Name
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>🎬 Status:</strong>
                        <span class="badge rounded-pill
                            @(Model.MovieStatus == MovieStatus.Available ? "bg-success" :
                                                                              Model.MovieStatus == MovieStatus.Upcoming ? "bg-warning text-dark" :
                                                                              "bg-danger")">
                            @Model.MovieStatus
                        </span>
                    </div>
                </div>

                <!-- الممثلين -->
                @if (Model.MovieActors?.Any() == true)
                {
                    <h5 class="fw-bold mt-4">🎭 Actors:</h5>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var actor in Model.MovieActors)
                        {
                            <a href="/Customer/Actor/Index/@actor.Actor.Id" class="text-decoration-none text-center">
                                <img src="~/Images/@actor.Actor.ProfilePictureUrl" class="rounded-circle shadow-sm border" style="width: 60px; height: 60px;" />
                                <div style="font-size: 0.85rem;">@($"{actor.Actor.FirstName} {actor.Actor.LastName}")</div>
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- الزر -->
            <div class="mt-4 text-center">
                <a href="#" class="btn px-5 py-2 fw-bold
                    @(Model.MovieStatus == MovieStatus.Expired ? "btn-secondary disabled" : "btn-success")">
                    🎫 Book Ticket
                </a>
            </div>
        </div>
    </div>
</div>

<!-- التريلر -->
@if (!string.IsNullOrEmpty(Model.TrailerUrl))
{
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">
        <h4 class="fw-bold mb-3">🎞️ Trailer</h4>
        <video src="@Model.TrailerUrl" controls class="w-100 rounded shadow" style="max-height: 500px;"></video>
    </div>
}


