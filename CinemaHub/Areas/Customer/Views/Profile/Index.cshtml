@model ApplicationUser

@{
    ViewData["Title"] = "Your Profile";
}

@if (TempData["success-notification"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow text-center animate__animated animate__fadeInDown" role="alert" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 300px; max-width: 90%;">
        <strong>✅ Success!</strong> @TempData["success-notification"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container d-flex align-items-center justify-content-center min-vh-100 profile-page">
    <div class="card shadow-lg border-0 rounded-4 p-4 w-100" style="max-width: 600px;">
        <h2 class="text-center mb-4 text-warning">👤 Your Profile</h2>

        <dl class="row">
            <dt class="col-sm-4">First Name:</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>

            <dt class="col-sm-4">Last Name:</dt>
            <dd class="col-sm-8">@Model.LastName</dd>

            <dt class="col-sm-4">User Name:</dt>
            <dd class="col-sm-8">@Model.UserName</dd>

            <dt class="col-sm-4">Email:</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Address:</dt>
            <dd class="col-sm-8">@Model.Address</dd>
        </dl>

        <div class="text-center mt-4">
            <a asp-area="Customer" asp-controller="Profile" asp-action="Edit"
               class="btn btn-outline-info fw-bold">
                ⚙️ Edit Your Info
            </a>
        </div>
    </div>
</div>
