@using CinemaHub.ViewModels
@model ChangePasswordVM

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 shadow-lg" style="max-width: 500px; width: 100%;">
        <h3 class="text-center mb-4 text-warning">🔒 Change Password</h3>

        <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="All" class="text-danger small"></div>

            <div class="form-group mb-3">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" type="password" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning fw-bold">🔁 Change Password</button>
            </div>
        </form>
    </div>
</div>
