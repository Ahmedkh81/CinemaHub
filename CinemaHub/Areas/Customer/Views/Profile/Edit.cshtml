@model CinemaHub.ViewModels.EditProfileVM
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100 profile-edit-page">
    <div class="card shadow-lg border-0 rounded-4 p-4 w-100" style="max-width: 600px;">
        <h2 class="text-center mb-4 text-warning">📝 Edit Your Profile</h2>

        @if (TempData["success-notification"] != null)
        {
            <div class="alert alert-success text-center shadow-sm mb-3">
                @Html.Raw(TempData["success-notification"])
            </div>
        }
        @if (TempData["error-notification"] != null)
        {
            <div class="alert alert-danger text-center shadow-sm mb-3">
                @Html.Raw(TempData["error-notification"])
            </div>
        }

        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <div class="form-group mb-3">
                <label asp-for="FirstName" class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastName" class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UserName" class="form-label">Username</label>
                <input asp-for="UserName" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning fw-bold">💾 Save Changes</button>
            </div>
        </form>

        <div class="text-center mt-4">
            <a asp-area="Customer" asp-controller="Profile" asp-action="ChangePassword"
               class="btn btn-outline-info fw-bold">
                ⚙️ Change My Password
            </a>
        </div>

        <div class="mt-3 text-center">
            <a asp-action="Index" class="fw-semibold link-info">🔙 Back to Home</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

