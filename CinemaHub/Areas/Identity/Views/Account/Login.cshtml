@using CinemaHub.ViewModels
@model LoginVM
@{
    ViewData["Title"] = "Login";
}

@if (TempData["success-notification"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow text-center animate__animated animate__fadeInDown" role="alert" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 300px; max-width: 90%;">
        <strong>✅ Success!</strong> @TempData["success-notification"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["error-notification"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow text-center animate__animated animate__fadeInDown" role="alert" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 300px; max-width: 90%;">
        <strong>❌ Error!</strong> @TempData["error-notification"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container d-flex align-items-center justify-content-center min-vh-100 register-container">
    <div class="card register-card shadow-lg border-0 rounded-4 p-4" style="max-width:500px;width:100%;">
        <h2 class="text-center mb-4 register-title">🔐 Sign In</h2>

        <form asp-action="Login" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="UserNameOrEmail" class="form-label">Username or Email</label>
                <input asp-for="UserNameOrEmail" class="form-control register-input" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control register-input" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning fw-bold">🚀 Login</button>
            </div>
        </form>

        <div class="mt-3 text-center">
            <span>
                Don’t have an account? 
                <a asp-action="Register" asp-controller="Account" asp-area="Identity" class="link-login">Register here</a>
            </span><br />
            <span>
                <a asp-action="ForgotPassword" asp-controller="Account" asp-area="Identity" class="link-login">Forgot password?</a>
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

