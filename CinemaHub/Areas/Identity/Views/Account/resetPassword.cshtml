@using CinemaHub.ViewModels
@model ResetPasswordVM
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100 reset-page">
    <div class="card shadow-lg border-0 rounded-4 p-4 reset-card" style="max-width: 500px; width: 100%;">
        <h2 class="text-center mb-4 text-warning">🔑 Reset Your Password</h2>

        @if (TempData["success-notification"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow text-center animate__animated animate__fadeInDown" role="alert" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 300px; max-width: 90%;">
                <strong>✅ Success!</strong> @Html.Raw(TempData["success-notification"])
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error-notification"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow text-center animate__animated animate__fadeInDown" role="alert" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 300px; max-width: 90%;">
                <strong>❌ Error!</strong> @Html.Raw(TempData["error-notification"])
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <div class="form-group mb-3">
                <label asp-for="OTP" class="form-label">OTP Code</label>
                <input asp-for="OTP" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="OTP" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">New Password</label>
                <input asp-for="Password" class="form-control border-secondary bg-body text-body" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control border-secondary bg-body text-body" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning fw-bold">✔️ Reset Password</button>
            </div>
        </form>

        <div class="mt-3 text-center">
            <span>Back to <a asp-action="Login" asp-controller="Account" class="fw-semibold link-info">Login</a></span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

