@using CinemaHub.ViewModels
@model ResendEmailConfirmationVM

@{
    ViewData["Title"] = "Resend Email Confirmation";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100 bg-body text-body">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 500px; width: 100%;">
        <h2 class="text-center mb-4 text-warning">📧 Resend Confirmation Email</h2>

        <form asp-action="ResendEmailConfirmation" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="EmailOrUserName" class="form-label">Email or Username</label>
                <input asp-for="EmailOrUserName" class="form-control border-secondary bg-body text-body" />
                <span asp-validation-for="EmailOrUserName" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning fw-bold">📨 Send Confirmation Email</button>
            </div>
        </form>

        <div class="mt-3 text-center">
            <span>Already confirmed? <a asp-action="Login" asp-controller="Account" class="text-info">Login here</a></span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

