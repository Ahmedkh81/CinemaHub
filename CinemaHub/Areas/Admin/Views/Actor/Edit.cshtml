@model Actor

<div class="container">
    <div class="row my-3">
        <div class="col-12">
            <form enctype="multipart/form-data" method="post">
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input type="text" class="form-control" asp-for="FirstName">
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input type="text" class="form-control" asp-for="LastName">
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="imageInput" class="form-label">Profile Picture</label>
                    <input type="file" class="form-control" id="imageInput" name="ProfilePictureUrl" accept="image/*">
                </div>

                <div class="mb-3">
                    <img id="previewImage" src="@(Model?.ProfilePictureUrl != null ? Url.Content("~/Images/" + Model.ProfilePictureUrl) : "#")"
                         style="max-height: 150px;" class="img-thumbnail" alt="Image Preview" />
                </div>
                <div class="mb-3">
                    <label asp-for="Bio" class="form-label">Bio</label>
                    <input type="text" class="form-control" asp-for="Bio">
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="News" class="form-label">News</label>
                    <input type="text" class="form-control" asp-for="News">
                    <span asp-validation-for="News" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const [file] = event.target.files;
            if (file) {
                const preview = document.getElementById('previewImage');
                preview.src = URL.createObjectURL(file);
            }
        });
    </script>
}