@using CinemaHub.Utility
@model IEnumerable<Cinema>



<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <h2 class="fw-bold mb-3 mb-md-0">🎬 All Cinemas</h2>
        @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
        {
            <a href="/Admin/Cinema/Create" class="btn btn-success shadow-sm px-4">
                <i class="bi bi-plus-circle me-2"></i> Create New Cinema
            </a>
        }
    </div>

    @section Scripts {
        <script>
            @if (TempData["success-notification"] is not null)
            {
                <text>
                    toastr.success('@TempData["success-notification"]');
                </text>
            }
                document.addEventListener("DOMContentLoaded", function () {
                const deleteButtons = document.querySelectorAll(".btn-delete");

                deleteButtons.forEach(button => {
                    button.addEventListener("click", function (e) {
                        e.preventDefault();
                        const deleteUrl = this.getAttribute("href");

                        Swal.fire({
                            title: 'Are you sure?',
                            text: "This cinema will be permanently deleted.",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#d33',
                            cancelButtonColor: '#3085d6',
                            confirmButtonText: 'Yes, delete it!',
                            reverseButtons: true
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = deleteUrl;
                            }
                        });
                    });
                });
            });

        </script>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Logo</th>
                    <th>Location</th>
                    @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td class="fw-semibold">@item.Name</td>
                        @if (item.Description is not null && item.Description.Length > 50)
                        {
                            <td>@item.Description.Substring(0, 10)...</td>
                        }
                        else
                        {
                            <td>@item.Description</td>
                        }
                    <td>@item.CinemaLogo</td>
                    <td>@item.Location</td>
                    <td class="text-end">
                            @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
                            {
                                <a href="/Admin/Cinema/Edit/@item.Id" class="btn btn-sm btn-warning me-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a href="/Admin/Cinema/Delete/@item.Id"
                                   class="btn btn-sm btn-danger btn-delete"
                                   data-id="@item.Id">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

