@using CinemaHub.Utility
@model IEnumerable<Category>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <h2 class="fw-bold mb-3 mb-md-0">🎬 All Categories</h2>
        @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
        {
            <a href="/Admin/Category/Create" class="btn btn-success shadow-sm px-4">
                <i class="bi bi-plus-lg me-2"></i> Create New Category
            </a>
        }
    </div>

    <!-- Success Notification -->
    @if (TempData["success-notification"] is not null)
    {
        @section Scripts {
            <script>
                toastr.success('@TempData["success-notification"]');
            </script>
        }
    }

    <!-- Category Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
                    {
                        <th scope="col" class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="text-end">
                            @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
                            {
                                <a href="/Admin/Category/Edit/@item.Id" class="btn btn-warning btn-sm me-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                            }
                            @if (User.IsInRole(Sd.SuperAdmin) || User.IsInRole(Sd.Admin))
                            {
                                <a href="/Admin/Category/Delete/@item.Id"
                                   class="btn btn-danger btn-sm btn-delete"
                                   data-id="@item.Id">
                                    <i class="bi bi-trash3"></i> Delete
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SweetAlert Delete Confirmation -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const deleteUrl = this.getAttribute("href");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "This category will be permanently deleted.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = deleteUrl;
                    }
                });
            });
        });
    });
</script>

